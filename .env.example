# Copy to .env and fill in. Never commit .env.

# Spotify: https://developer.spotify.com/dashboard -> Create app
#   Redirect URI: http://127.0.0.1:8888/callback   (APIs used: Web API)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Any voice id from the ElevenLabs voice library (default: "George")
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ASI:One: https://asi1.ai/dashboard/api-keys
ASI1_API_KEY=

# Fetch.ai agent: any long random phrase. Keep it secret; it IS the agent's identity.
AGENT_SEED=
